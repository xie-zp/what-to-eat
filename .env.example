LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=all-in-rag
NEO4J_DATABASE=neo4j

MILVUS_URI=http://localhost:19531
MILVUS_COLLECTION=recipe_knowledge
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
HF_CACHE_PATH=./.runtime/huggingface

AGENT_DB_PATH=./data/agent_state.sqlite3
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite3
MAX_AGENT_STEPS=12
USE_NEO4J=true
USE_HYBRID=true
USE_FILE_SEARCH=false
USE_LLM_PLANNER=true
USE_LLM_QUERY_ANALYZER=true
USE_LLM_RESPONDER=true
RECIPE_DATA_PATH=./data/generated/recipes.json

OTEL_ENABLED=false
OTEL_SERVICE_NAME=recipe-agent
OTEL_ENVIRONMENT=local
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
